{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-management-framework:0.1:schema:binding",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "SMF Binding",
  "type": "object",
  "properties": {
    "smf": {
      "const": "0.1"
    },
    "kind": {
      "const": "Binding"
    },
    "subject": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+(@v[0-9]+)?$",
      "description": "Reference to an ID, optionally pinned to a version (id@vN)."
    },
    "implementation": {
      "type": "object",
      "properties": {
        "platform": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        }
      },
      "required": [
        "platform",
        "ref"
      ],
      "additionalProperties": false
    },
    "baseline": {
      "type": "string"
    },
    "conformance_status": {
      "enum": [
        "conformant",
        "non_conformant",
        "untested",
        "legacy"
      ]
    }
  },
  "required": [
    "smf",
    "kind",
    "subject",
    "implementation"
  ],
  "additionalProperties": false
}
