{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:semantic-management-framework:0.1:schema:term",
  "$comment": "SPDX-License-Identifier: Apache-2.0",
  "title": "SMF Term",
  "type": "object",
  "properties": {
    "smf": {
      "const": "0.1"
    },
    "kind": {
      "const": "Term"
    },
    "term": {
      "type": "string",
      "minLength": 1
    },
    "maps_to": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+(@v[0-9]+)?$",
      "description": "Reference to an ID, optionally pinned to a version (id@vN)."
    },
    "context": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+(@v[0-9]+)?$",
      "description": "Reference to an ID, optionally pinned to a version (id@vN)."
    },
    "preferred": {
      "type": "boolean"
    },
    "deprecated": {
      "type": "boolean"
    },
    "locale": {
      "type": "string"
    }
  },
  "required": [
    "smf",
    "kind",
    "term",
    "maps_to"
  ],
  "additionalProperties": false
}
